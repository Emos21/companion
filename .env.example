# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# On the deployed backend, set these as host environment variables, not in code.

# Which LLM the live demo runs on: "minimax" (default) or "anthropic"
LLM_PROVIDER=minimax

# MiniMax M3 - real value lives only in .env / host env, never in git
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Anthropic - optional, the adapter is provider-swappable
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase / Postgres (pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Escalation thresholds (tunable)
MIN_ANSWER_CONFIDENCE=0.6
MIN_RETRIEVAL_SCORE=0.25
